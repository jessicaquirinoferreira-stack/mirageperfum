rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jessicaq2204@gmail.com' ||
        request.auth.token.email == 'admin@x.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // Products collection: publicly viewable if active, manageable by admin
    match /products/{productId} {
      allow read: if isValidId(productId) && (resource.data.status == 'active' || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Orders collection: any customer can create an order during checkout, only admin can read and update
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidId(orderId) && 
        incoming().customerName is string && incoming().customerName.size() <= 150 &&
        incoming().customerPhone is string && incoming().customerPhone.size() <= 40 &&
        incoming().customerEmail is string && incoming().customerEmail.size() <= 150 &&
        incoming().total is number;
    }

    // Leads collection: visitors can submit leads (newsletter/checkout), only admin can read and manage
    match /leads/{leadId} {
      allow read, update, delete: if isAdmin();
      allow create: if isValidId(leadId) &&
        incoming().email is string && incoming().email.size() <= 150;
    }

    // Coupons collection: customers can read coupons to validate promo codes at checkout, only admin can manage
    match /coupons/{couponId} {
      allow read: if isValidId(couponId);
      allow create, update, delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
